<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Fallback when Main hasn't run (e.g. unit tests that load SLF4J directly).
         Logback evaluates this at context init; Main#main overrides it via
         System.setProperty before any logger is touched in production. -->
    <property name="LOG_DIR" value="${LOG_DIR:-${java.io.tmpdir}/tate-yoko-pdf-logs}" />
    <!--
      Two appenders by design:
       - STDOUT: human-readable, useful for `just web` / CLI mode where a terminal is attached.
                 Silently invisible on a Windows jpackage launcher (no console window) — which is
                 fine, because operators read FILE instead.
       - FILE:   structured JSON at LOG_DIR/app.log with rolling retention. LOG_DIR is set by
                 Main#resolveLogDir to the platform-standard location:
                   Linux:   $XDG_DATA_HOME/tate-yoko-pdf  (fallback ~/.local/share/tate-yoko-pdf)
                   macOS:   ~/Library/Logs/tate-yoko-pdf
                   Windows: %APPDATA%/tate-yoko-pdf/logs
                 Falls back to ${java.io.tmpdir}/tate-yoko-pdf-logs if the platform path is unwritable.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] [%-5level] [traceId=%X{traceId:-}] [jobId=%X{jobId:-}] %logger{36} - %msg%n%rEx</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
            <includeContext>false</includeContext>
            <customFields>{"app":"tate-yoko-pdf"}</customFields>
            <fieldNames>
                <timestamp>ts</timestamp>
                <message>msg</message>
                <thread>thread</thread>
                <logger>logger</logger>
                <level>level</level>
                <stackTrace>stack</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

    <logger name="org.eclipse.jetty" level="WARN" />
    <logger name="io.javalin" level="INFO" />
    <logger name="org.apache.pdfbox" level="WARN" />
</configuration>
