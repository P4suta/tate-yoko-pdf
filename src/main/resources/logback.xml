<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      A single console appender on stderr. stderr (not stdout) is used on purpose so that
      stdout stays a clean PDF byte stream in `-o -` (pipe) mode. There is no file logging:
      this is a CLI tool, so diagnostics belong on the terminal, not in a platform log dir.
    -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] [%-5level] %logger{36} - %msg%n%rEx</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>

    <logger name="org.apache.pdfbox" level="WARN" />
</configuration>
